# Database
DATABASE_URL="postgresql://user:password@localhost:5432/planning_poker"

# AI Provider Configuration
# Options: 'anthropic', 'openai', 'bedrock', 'kiro', 'none'
AI_PROVIDER=none

# Anthropic Configuration (if using AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# OpenAI Configuration (if using AI_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# AWS Bedrock Configuration (if using AI_PROVIDER=bedrock)
# Uses AWS credentials from environment or IAM role
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Kiro Configuration (if using AI_PROVIDER=kiro)
# Requires the `kiro-cli` binary to be installed and authenticated on the host
# running the server.
KIRO_CLI_PATH=kiro-cli
KIRO_TIMEOUT_MS=60000

# Jira Integration (optional)
# If provided, stories with Jira URLs will automatically import description and images.
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=your_jira_api_token_here
JIRA_COMPANY=yourcompany

# Azure DevOps Integration (optional)
# If provided, stories with Azure DevOps work item URLs
# (https://dev.azure.com/{org}/{project}/_workitems/edit/{id}) will automatically
# import title and description, and story points can be published back to
# Microsoft.VSTS.Scheduling.StoryPoints.
AZURE_DEVOPS_ORG=yourorg
AZURE_DEVOPS_PAT=your_personal_access_token_here
# Optional: default project used when a URL omits the project segment.
AZURE_DEVOPS_PROJECT=yourproject
